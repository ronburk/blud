-- expect: test0017.out
-- Rule operands remain together while multi-target rules are split.

all:

do
    local state = {
        calls = 0,
        captures = {},
    }

    state.operator = setmetatable(
        {},
        getmetatable(blud.operators[":"])
    )
    function state.operator:EVAL_RULE(operands, action)
        self:ADD_RULES(operands, action)
    end

    function state.operator:ADD_RULE(operands, action)
        assert(#operands.targets == 1,
               "capture ADD_RULE expected exactly one target")
        local target = operands.targets[1]
        state.calls = state.calls + 1
        state.captures[target.NAME] = {
            directory = operands.directory,
            normal = operands.prerequisites,
            action = action,
            order_only = operands.ordered_prerequisites,
        }
    end

    blud.test0017_state = state
    blud.operators[":CAPTURE:"] = state.operator
end

TEST0017_SEPARATOR = |
TEST0017_DIRECTORY = captured-directory

no_separator :CAPTURE: normal_a normal_b
{$(TEST0017_DIRECTORY)} with_directory_a with_directory_b :CAPTURE: normal_directory | order_directory
{$(TEST0017_DIRECTORY)/./} normalized_directory :CAPTURE: normal_directory | order_directory
spaced :CAPTURE: normal_a normal_b | order_a order_b
adjacent :CAPTURE: normal_a normal_b|order_a order_b
empty_normal :CAPTURE: | order_a order_b
empty_order :CAPTURE: normal_a normal_b |
macro_separator :CAPTURE: normal_a$(TEST0017_SEPARATOR)order_a
with_action :CAPTURE: normal_action | order_action
    touch test0017-unexpected

assignment: PIPE_VALUE = a|b

do
    local AliasDir = require("blud.aliasdir")
    local state = blud.test0017_state

    local function assert_words(name, kind, expected)
        local actual = state.captures[name][kind]
        assert(type(actual) == "table",
               name .. " " .. kind .. " prerequisites were not a table")
        assert(#actual == #expected,
               string.format(
                   "%s had %d %s prerequisites instead of %d",
                   name,
                   #actual,
                   kind,
                   #expected))
        for i = 1, #expected do
            assert(actual[i] == expected[i],
                   string.format(
                       "%s %s prerequisite %d was %s instead of %s",
                       name,
                       kind,
                       i,
                       tostring(actual[i]),
                       expected[i]))
        end
    end

    assert_words("no_separator", "normal", {"normal_a", "normal_b"})
    assert_words("no_separator", "order_only", {})
    assert(state.captures.no_separator.directory == AliasDir.to_absolute("."),
           "rule without a directory did not use the current directory")

    local captured_directory = AliasDir.to_absolute("captured-directory")
    for _, name in ipairs({
        "captured-directory/with_directory_a",
        "captured-directory/with_directory_b",
    }) do
        assert(state.captures[name].directory == captured_directory,
               "split rule did not canonicalize its directory operand")
        assert_words(name, "normal", {"normal_directory"})
        assert_words(name, "order_only", {"order_directory"})
    end
    assert(state.captures["captured-directory/normalized_directory"].directory ==
           captured_directory,
           "rule directory was not lexically normalized")

    for _, name in ipairs({"spaced", "adjacent"}) do
        assert_words(name, "normal", {"normal_a", "normal_b"})
        assert_words(name, "order_only", {"order_a", "order_b"})
    end

    assert_words("empty_normal", "normal", {})
    assert_words("empty_normal", "order_only", {"order_a", "order_b"})
    assert_words("empty_order", "normal", {"normal_a", "normal_b"})
    assert_words("empty_order", "order_only", {})
    assert_words("macro_separator", "normal", {"normal_a"})
    assert_words("macro_separator", "order_only", {"order_a"})

    local with_action = state.captures.with_action
    assert(type(with_action.action) == "function",
           "rule action was not passed as the second operator argument")
    assert_words("with_action", "normal", {"normal_action"})
    assert_words("with_action", "order_only", {"order_action"})

    local colon = blud.operators[":"]
    colon:EVAL_RULE({
        directory = "directory-one",
        targets = {"same/../shared-target"},
        prerequisites = {},
        ordered_prerequisites = {},
    }, nil)
    colon:EVAL_RULE({
        directory = "./directory-one",
        targets = {"shared-target"},
        prerequisites = {},
        ordered_prerequisites = {},
    }, nil)
    colon:EVAL_RULE({
        directory = "directory-two",
        targets = {"shared-target"},
        prerequisites = {},
        ordered_prerequisites = {},
    }, nil)
    local accepted, error_message = pcall(function()
        colon:EVAL_RULE({
            directory = "directory-two",
            targets = {"../directory-one/shared-target"},
            prerequisites = {},
            ordered_prerequisites = {},
        }, nil)
    end)
    assert(not accepted,
           "same target declared from different directories was accepted")
    assert(tostring(error_message):find(
               "more than one directory", 1, true),
           "directory-conflict error had an unexpected message: " ..
           tostring(error_message))

    local calls_before_error = state.calls
    accepted, error_message = pcall(
        blud.eval_rule,
        ":CAPTURE:",
        {
            targets = {"multiple_separators"},
            prerequisites = {"normal | order | extra"},
        },
        nil
    )
    assert(not accepted,
           "prerequisite parser accepted more than one '|' separator")
    assert(tostring(error_message):find(
               "more than one '|' separator", 1, true),
           "multiple-separator error had an unexpected message: " ..
           tostring(error_message))
    assert(state.calls == calls_before_error,
           "operator was called after multiple separators were rejected")

    local assignment = blud.get_or_create_target("assignment")
    assert(assignment.SCOPE:get_text("PIPE_VALUE") == "a|b",
           "target-specific assignment split its '|' character")

    blud.operators[":CAPTURE:"] = nil
    blud.test0017_state = nil

    local output, error_message = io.open("test0017.out", "w")
    assert(output,
           "could not create test0017.out: " .. tostring(error_message))
    output:close()
end
