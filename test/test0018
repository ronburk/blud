-- expect: test0018.out
-- A rejected implicit rule must not remain in either rule index.

-- The harness invokes this test as a child Blud process and checks the Lua
-- assertions by requiring the test to create its success marker.
-- _BLUD_TEST_
-- rm -f test0018.out
-- $(OWD)/blud -f $<
-- test -e test0018.out
-- rm -f test0018.out
-- _BLUD_TEST_

all:

do
    local errmsg = blud.implicit.add_rule(
        "%.transactional-output",
        { "%.transactional-input", "%" })
    assert(errmsg, "invalid implicit rule was accepted")
    assert(not blud.implicit.find_reverse("source.transactional-input"),
           "invalid implicit rule remained in the reverse-rule index")

    local output, error_message = io.open("test0018.out", "w")
    assert(output,
           "could not create test0018.out: " .. tostring(error_message))
    output:close()
end
