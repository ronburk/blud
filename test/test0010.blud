INNER = inner
OUTER = $(INNER)tail

all: first second first
    echo $@
    echo $<
    echo $^
    echo $(BLUD_SCOPE_ENV)
    echo $(OUTER)

first:
    touch $@

second:
    touch $@


TARGET_FALLBACK = outer
TARGET_APPEND = outer

target_parent: TARGET_ONLY = parent
target_parent: TARGET_FALLBACK = parent
target_parent: TARGET_APPEND += parent
target_parent: target_child
    echo parent:$(TARGET_ONLY):$(TARGET_FALLBACK):$(TARGET_APPEND)

target_child:
    echo child:$(TARGET_ONLY):$(TARGET_FALLBACK):$(TARGET_APPEND)
