-- test0001 2026-07-23
--
-- Simple test to make sure SOMETHING works
--
-- _BLUD_TEST_ $(OWD)/blud -f $<


-- Macro assignment

ASSIGN_BASIC = first
assert($(ASSIGN_BASIC) == "first", "'=' failed to assign an undefined macro")

ASSIGN_BASIC = second
assert($(ASSIGN_BASIC) == "second", "'=' failed to replace an existing macro")

ASSIGN_EMPTY = nonempty
ASSIGN_EMPTY =
assert($(ASSIGN_EMPTY) == "", "'=' failed to replace a value with an empty value")

ASSIGN_DEFAULT ?= first
assert($(ASSIGN_DEFAULT) == "first", "'?=' failed to assign an undefined macro")

ASSIGN_DEFAULT ?= second
assert($(ASSIGN_DEFAULT) == "first", "'?=' replaced an existing macro")

ASSIGN_DEFAULT_EMPTY =
ASSIGN_DEFAULT_EMPTY ?= replacement
assert($(ASSIGN_DEFAULT_EMPTY) == "", "'?=' replaced a defined but empty macro")

ASSIGN_APPEND += first
assert($(ASSIGN_APPEND) == "first", "'+=' added whitespace when assigning an undefined macro")

ASSIGN_APPEND += second
assert($(ASSIGN_APPEND) == "first second", "'+=' failed to append with one separating space")

ASSIGN_APPEND +=
assert($(ASSIGN_APPEND) == "first second", "'+=' with an empty value changed the existing value")

ASSIGN_APPEND_EMPTY =
ASSIGN_APPEND_EMPTY += first
assert($(ASSIGN_APPEND_EMPTY) == "first", "'+=' added whitespace when appending to an empty macro")

ASSIGN_THEN_APPEND = first
ASSIGN_THEN_APPEND += second
assert($(ASSIGN_THEN_APPEND) == "first second", "'+=' failed after an ordinary '=' assignment")

ASSIGN_SELF = first
ASSIGN_SELF = $(ASSIGN_SELF) second
assert($(ASSIGN_SELF) == "first second", "self-reference in '=' did not use the previous value")

ASSIGN_SELF = before $(ASSIGN_SELF)
assert($(ASSIGN_SELF) == "before first second", "repeated self-assignment did not use the immediately previous value")

ASSIGN_MULTI_SELF = old
ASSIGN_MULTI_SELF = $(ASSIGN_MULTI_SELF) and $(ASSIGN_MULTI_SELF)
assert($(ASSIGN_MULTI_SELF) == "old and old", "multiple self-references did not all use the previous value")

ASSIGN_UNSPACED=unspaced
assert($(ASSIGN_UNSPACED) == "unspaced", "assignment without whitespace around '=' failed")

ASSIGN_SPACED   =   spaced
assert($(ASSIGN_SPACED) == "spaced", "assignment with whitespace around '=' failed")

ASSIGN_VALUE_SPACES = one  two   three
assert($(ASSIGN_VALUE_SPACES) == "one  two   three", "assignment did not preserve internal whitespace")

ASSIGN_OPERATOR_TEXT = one=two += three ?= four
assert($(ASSIGN_OPERATOR_TEXT) == "one=two += three ?= four", "assignment misparsed operators in its value")

ASSIGN_COMMENT = value-- $()
assert($(ASSIGN_COMMENT) == "value", "assignment did not remove its Lua comment")

-- Delayed and immediate macro expansion

EXPAND_SOURCE = first
EXPAND_DELAYED = $(EXPAND_SOURCE)
EXPAND_IMMEDIATE = ${EXPAND_SOURCE}

EXPAND_SOURCE = second
assert($(EXPAND_DELAYED) == "second", "delayed expansion did not use the current macro value")
assert($(EXPAND_IMMEDIATE) == "first", "immediate expansion did not preserve its assignment-time value")

EXPAND_SOURCE = third
assert($(EXPAND_DELAYED) == "third", "delayed expansion cached an earlier expansion")
assert($(EXPAND_IMMEDIATE) == "first", "immediate expansion changed after its source changed again")

EXPAND_DELAYED_UNDEFINED = $(EXPAND_DEFINED_LATER)
EXPAND_IMMEDIATE_UNDEFINED = ${EXPAND_DEFINED_LATER}
EXPAND_DEFINED_LATER = later
assert($(EXPAND_DELAYED_UNDEFINED) == "later", "delayed expansion did not find a macro defined later")
assert($(EXPAND_IMMEDIATE_UNDEFINED) == "", "immediate expansion of an undefined macro did not remain empty")

EXPAND_MIXED_SOURCE = first
EXPAND_MIXED = ${EXPAND_MIXED_SOURCE}/$(EXPAND_MIXED_SOURCE)
EXPAND_MIXED_SOURCE = second
assert($(EXPAND_MIXED) == "first/second", "mixed immediate and delayed expansion used incorrect values")

EXPAND_TRANSITIVE_SOURCE = first
EXPAND_TRANSITIVE_DELAYED = $(EXPAND_TRANSITIVE_SOURCE)
EXPAND_TRANSITIVE_IMMEDIATE = ${EXPAND_TRANSITIVE_DELAYED}
EXPAND_TRANSITIVE_SOURCE = second
assert($(EXPAND_TRANSITIVE_DELAYED) == "second", "transitive delayed expansion did not use the current value")
assert($(EXPAND_TRANSITIVE_IMMEDIATE) == "first", "immediate expansion did not recursively freeze a delayed value")

EXPAND_APPEND_SOURCE = first
EXPAND_APPEND_DELAYED = base
EXPAND_APPEND_DELAYED += $(EXPAND_APPEND_SOURCE)
EXPAND_APPEND_IMMEDIATE = base
EXPAND_APPEND_IMMEDIATE += ${EXPAND_APPEND_SOURCE}
EXPAND_APPEND_SOURCE = second
assert($(EXPAND_APPEND_DELAYED) == "base second", "'+=' did not preserve delayed expansion")
assert($(EXPAND_APPEND_IMMEDIATE) == "base first", "'+=' did not perform immediate expansion")

EXPAND_IMMEDIATE_SELF = old
EXPAND_IMMEDIATE_SELF = ${EXPAND_IMMEDIATE_SELF} new
assert($(EXPAND_IMMEDIATE_SELF) == "old new", "immediate self-reference did not use the previous value")

CFLAGS += -g
talk:
    echo "echo 1"
    echo "echo 2"
all: talk prog
    echo "test001 worked"
    touch test0001.out
