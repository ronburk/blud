blud = {
    assert = assert,
    error = error,
}

local Macro = require("macro")
local Scope = assert(loadfile("scope.lua"))()

local scope = Scope:new(nil, "test")
scope:set("NAME", "literal")
local macro = scope:get_macro("NAME")
local parts = macro:get_parts()
assert(type(parts) == "table")
assert(#parts == 1 and parts[1] == "literal")
assert(scope:get_macro("NAME") == macro)
assert(type(macro.get_parts) == "function")
assert(macro[1] == nil)

-- Function-backed macros share the expansion interface without exposing parts.
local function_macro = Macro.from_function(function(
    invocation_scope, actuals, stack)
    assert(invocation_scope == scope)
    assert(type(stack) == "table")
    return table.concat(actuals, ":")
end)
assert(function_macro.get_parts == nil)
scope:set_macro("FUNCTION", function_macro)
assert(scope:get_text("FUNCTION") == "FUNCTION")

local call_result = Macro.expand_call(scope, {
    { "FUNCTION" },
    { "argument" },
})
assert(#call_result == 1)
assert(call_result[1] == "FUNCTION:argument")

scope:set_boolean(".JUST_PRINT", true)
assert(scope:get_macro(".JUST_PRINT"):get_parts()[1] == "true")
assert(scope:get_boolean(".JUST_PRINT") == true)
scope:set_boolean(".JUST_PRINT", false)
assert(scope:get_boolean(".JUST_PRINT") == false)

local environment_parts = Scope.environment:get_macro("BLUD_SCOPE_ENV"):get_parts()
assert(type(environment_parts) == "table")
assert(#environment_parts == 1 and environment_parts[1] == "environment")

local target = {
    BOUND_NAME = "target",
    PREREQUISITES = {
        { BOUND_NAME = "first" },
        { BOUND_NAME = "second" },
        { BOUND_NAME = "first" },
    },
}
local target_scope = Scope:new_target_scope(target)

local target_parts = target_scope:get_macro("@"):get_parts()
assert(type(target_parts) == "table")
assert(#target_parts == 1 and target_parts[1] == "target")

local first_parts = target_scope:get_macro("<"):get_parts()
assert(type(first_parts) == "table")
assert(#first_parts == 1 and first_parts[1] == "first")

local prerequisites_parts = target_scope:get_macro("^"):get_parts()
assert(type(prerequisites_parts) == "table")
assert(#prerequisites_parts == 1)
assert(prerequisites_parts[1] == "first second ")


Scope.build:set("FALLBACK", "outer")
Scope.build:set("SHARED", "outer")

local parent_target = { BOUND_NAME = "parent", PREREQUISITES = {} }
local parent_scope = Scope:new_target_scope(parent_target)
assert(parent_scope.parent == Scope.build)
parent_scope:set("ONLY_HERE", "parent")
parent_scope:set("FALLBACK", "parent")
parent_scope:set("SHARED", "parent")

assert(parent_scope:get_text("ONLY_HERE") == "parent")
assert(parent_scope:get_text("FALLBACK") == "parent")
assert(parent_scope:get_text("SHARED") == "parent")

local child_target = { BOUND_NAME = "child", PREREQUISITES = {} }
local child_scope = Scope:new_target_scope(child_target)
assert(child_scope.parent == Scope.build)
assert(child_scope:get_macro("ONLY_HERE") == nil)
assert(child_scope:get_text("FALLBACK") == "outer")
assert(child_scope:get_text("SHARED") == "outer")

parent_scope:set_boolean(".ASSUME_NEW", true)
assert(parent_scope:get_boolean(".ASSUME_NEW") == true)
assert(child_scope:get_boolean(".ASSUME_NEW") == false)
